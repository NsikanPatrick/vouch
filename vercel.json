{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ], 
  "crons": [ 
    {
      "path": "/api/v1/auth/maintenance/clean-otps", 
      "schedule": "0 0 * * *" 
    }
  ]
}





